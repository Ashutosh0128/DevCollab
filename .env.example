# ==============================================================================
# DevCollab — Environment Configuration Template (.env.example)
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Django Configuration
SECRET_KEY=django-insecure-devcollab-phase1-secret-key-change-in-prod
DJANGO_SECRET_KEY=django-insecure-devcollab-phase1-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gunicorn Worker Concurrency (Default: 1 worker for lightweight 8GB RAM local Docker)
WEB_CONCURRENCY=1

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=devcollab
DB_USER=devcollab_user
DB_PASSWORD=devcollab_password
DB_HOST=db
DB_PORT=5432
# DATABASE_URL=postgres://devcollab_user:devcollab_password@db:5432/devcollab

# JWT Authentication Configuration
JWT_SECRET_KEY=django-insecure-devcollab-phase1-secret-key-change-in-prod
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# GitHub Integration Placeholder
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Local Ollama AI Configuration (Phase 9)
# Native Windows Django: OLLAMA_HOST=http://localhost:11434
# Dockerized Django: OLLAMA_HOST=http://host.docker.internal:11434
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434
AI_ENABLED=true

# Email Configuration Placeholder
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# S3 / Object Storage Configuration Placeholder
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

