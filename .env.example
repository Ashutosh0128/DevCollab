# ==============================================================================
# DevCollab — Environment Configuration Template (.env.example)
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-devcollab-phase1-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=devcollab
DB_USER=devcollab_user
DB_PASSWORD=devcollab_password
DB_HOST=db
# JWT Authentication Configuration
JWT_SECRET_KEY=django-insecure-devcollab-phase1-secret-key-change-in-prod
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# GitHub Integration (Phase 8 Placeholder)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# AI Service Credentials (Phase 11 Placeholder)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Configuration Placeholder
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# S3 / Object Storage Configuration Placeholder (Phase 12)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
